# Base Postgres (Neon, Vercel Postgres ou Supabase) — voir README étape 1
DATABASE_NEON_URL=postgresql://user:password@host/dbname?sslmode=require

# Mot de passe unique demandé à la connexion
APP_PASSWORD=choisis-un-mot-de-passe

# Clé de signature des cookies de session.
# Génère-la avec :  openssl rand -base64 32
# Si elle est absente, APP_PASSWORD est utilisé à la place — ça marche, mais
# changer le mot de passe déconnecte alors toutes les sessions en cours.
SESSION_SECRET=

# Mot de passe d'une session de DÉMONSTRATION, en lecture seule (optionnel).
# Laisse vide pour qu'aucun mot de passe de démonstration n'existe — le lien
# /demo, lui, fonctionne indépendamment de ce réglage.
DEMO_PASSWORD=

# Le lien de démonstration /demo ouvre une session sans mot de passe : c'est ce
# qu'on envoie à quelqu'un à qui on veut montrer l'app. Il ne donne accès à
# AUCUNE donnée réelle — la session voit un foyer fictif et ne peut rien écrire.
# Mets « off » pour le désactiver et ne garder que DEMO_PASSWORD.
DEMO_LINK=

# Jeton attendu par /api/cron/snapshot, appelé chaque nuit par Vercel Cron.
# Vercel le génère et l'injecte automatiquement si tu ne le définis pas toi-même.
CRON_SECRET=
